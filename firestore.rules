/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a user-ownership model for translation tasks,
 *              allowing only the owner to read, update, or delete their own tasks.
 *              Glossaries are currently public, but this can be restricted.
 *
 * Data Structure:
 * - /translationTasks/{taskId}: Stores translation tasks owned by users.
 * - /glossaries/{glossaryId}: Stores glossaries, currently publicly accessible.
 *
 * Key Security Decisions:
 * - User listing is disabled for translation tasks to prevent unauthorized data access.
 * - Glossary access is currently public.
 *
 * Denormalization for Authorization:
 * - Translation tasks contain an `ownerUid` field to quickly verify ownership.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to translation tasks. Only the owner can read, update, or delete.
     * @path /translationTasks/{taskId}
     * @allow (get) User '7MvWJDhHW7h477og59aXNGxm7gG2' can read a translation task if they are the owner.
     * @allow (create) User '7MvWJDhHW7h477og59aXNGxm7gG2' can create a translation task if the `ownerUid` field matches their UID.
     * @allow (update) User '7MvWJDhHW7h477og59aXNGxm7gG2' can update a translation task if they are the owner and the document exists.
     * @allow (delete) User '7MvWJDhHW7h477og59aXNGxm7gG2' can delete a translation task if they are the owner and the document exists.
     * @deny (get) User 'randomUid' cannot read a translation task if they are not the owner.
     * @deny (create) User 'randomUid' cannot create a translation task if the `ownerUid` field does not match their UID.
     * @deny (update) User 'randomUid' cannot update a translation task if they are not the owner.
     * @deny (delete) User 'randomUid' cannot delete a translation task if they are not the owner.
     * @principle Enforces document ownership for writes.
     */
    match /translationTasks/{taskId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(ownerUid) {
        return isSignedIn() && request.auth.uid == ownerUid;
      }

      function isExistingOwner(ownerUid) {
        return isOwner(ownerUid) && resource != null;
      }

      allow get: if isOwner(resource.data.ownerUid);
      allow list: if isOwner(request.auth.uid);
      allow create: if isOwner(request.resource.data.ownerUid);
      allow update: if isExistingOwner(resource.data.ownerUid) && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if isExistingOwner(resource.data.ownerUid);
    }

    /**
     * @description Controls access to glossaries. Currently, all read access is public.
     *              Write access is open.
     * @path /glossaries/{glossaryId}
     * @allow (get) Any user can read a glossary.
     * @allow (list) Any user can list glossaries.
     * @allow (create) Any user can create a glossary.
     * @allow (update) Any user can update a glossary.
     * @allow (delete) Any user can delete a glossary.
     * @principle Allows public read access to glossaries.
     */
    match /glossaries/{glossaryId} {
      allow get, list: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }
  }
}