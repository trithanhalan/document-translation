/**
 * @file Overview
 * This ruleset enforces a user-ownership model for translation tasks,
 * allowing users to only access and modify tasks they own.
 * Glossaries are currently public.
 *
 * Data Structure:
 * - /translationTasks/{taskId}: Stores individual translation tasks, each owned by a specific user.
 * - /glossaries/{glossaryId}: Stores glossaries of terms.
 *
 * Key Security Decisions:
 * - Users can only create, read, update, and delete their own translation tasks.
 * - Glossaries are publicly readable. Writes to glossaries are not allowed (for now).
 * - Listing of translation tasks is allowed only for the owner.
 *
 * Denormalization for Authorization:
 * - Each translation task document MUST contain an `ownerUid` field that matches the user's UID. This avoids needing to query a separate collection to determine ownership.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to translation task documents.
     * @path /translationTasks/{taskId}
     * @allow (create) User with UID 'user123' can create a task with ownerUid: 'user123'.
     * @deny (create) User with UID 'user456' cannot create a task with ownerUid: 'user123'.
     * @allow (get) User with UID 'user123' can read a task they own.
     * @deny (get) User with UID 'user456' cannot read a task owned by 'user123'.
     * @allow (update) User with UID 'user123' can update a task they own.
     * @deny (update) User with UID 'user456' cannot update a task owned by 'user123'.
     * @allow (delete) User with UID 'user123' can delete a task they own.
     * @deny (delete) User with UID 'user456' cannot delete a task owned by 'user123'.
     * @principle Enforces document ownership for writes.
     */
    match /translationTasks/{taskId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(ownerUid) {
        return isSignedIn() && request.auth.uid == ownerUid;
      }

      function isExistingOwner(ownerUid) {
        return isOwner(ownerUid) && resource != null;
      }

      allow get: if true;
      allow list: if isSignedIn() && isOwner(resource.data.ownerUid);
      allow create: if isSignedIn() && isOwner(request.resource.data.ownerUid);
      allow update: if isExistingOwner(resource.data.ownerUid);
      allow delete: if isExistingOwner(resource.data.ownerUid);
    }

    /**
     * @description Controls access to glossary documents. Currently allows public read access.
     * @path /glossaries/{glossaryId}
     * @allow (get) Any user can read a glossary.
     * @allow (list) Any user can list glossaries.
     * @deny (create) No one can create glossaries.
     * @deny (update) No one can update glossaries.
     * @deny (delete) No one can delete glossaries.
     * @principle Allows public read access to glossaries.
     */
    match /glossaries/{glossaryId} {
      allow get: if true;
      allow list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }
  }
}