/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a user-ownership model for translation tasks,
 *              allowing only the task owner to read, update, or delete their tasks.
 *              Glossaries are currently public, but a placeholder is added for future owner-based restrictions.
 *
 * Data Structure:
 * - /translationTasks/{taskId}: Stores translation tasks, with 'ownerUid' field indicating ownership.
 * - /glossaries/{glossaryId}: Stores glossaries.
 *
 * Key Security Decisions:
 * - User listing is disallowed to protect user privacy.
 * - Glossaries are currently public read, but future changes will restrict writes to owners (requires schema update).
 *
 * Denormalization for Authorization:
 * - The `translationTasks` documents contain an `ownerUid` field, enabling direct ownership checks without additional reads.
 *
 * Structural Segregation:
 * - No structural segregation is used, as there's no concept of public vs. private tasks.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to translation task documents.
     * @path /translationTasks/{taskId}
     * @allow (create) User creates a new task with their UID as the ownerUid.
     * @allow (get) User retrieves a task they own.
     * @allow (update) User updates a task they own.
     * @allow (delete) User deletes a task they own.
     * @deny (create) User attempts to create a task with an ownerUid that doesn't match their UID.
     * @deny (get) User attempts to retrieve a task they don't own.
     * @deny (update) User attempts to update a task they don't own.
     * @deny (delete) User attempts to delete a task they don't own.
     * @principle Enforces document ownership for all operations.
     */
    match /translationTasks/{taskId} {
      // Helper function to check if the user is signed in
      function isSignedIn() {
        return request.auth != null;
      }

      // Helper function to check if the user is the owner of the task
      function isOwner(ownerUid) {
        return isSignedIn() && request.auth.uid == ownerUid;
      }

       // Helper function to check if the user is the owner of the task and the resource exists
      function isExistingOwner(ownerUid) {
        return isOwner(ownerUid) && resource != null;
      }


      allow get: if true;
      allow list: if false;

      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid && request.resource.data.id == taskId;
      allow update: if isExistingOwner(resource.data.ownerUid) && resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if isExistingOwner(resource.data.ownerUid);
    }

    /**
     * @description Controls access to glossary documents.  Currently allows public read access.
     * @path /glossaries/{glossaryId}
     * @allow (get) Any user can read a glossary.
     * @allow (list) Any user can list glossaries.
     * @deny (create) No one can create a glossary (TODO: Add owner validation once the schema is updated with an ownership field).
     * @deny (update) No one can update a glossary (TODO: Add owner validation once the schema is updated with an ownership field).
     * @deny (delete) No one can delete a glossary (TODO: Add owner validation once the schema is updated with an ownership field).
     * @principle Allows public read access to glossaries, but restricts writes.
     */
    match /glossaries/{glossaryId} {
      allow get, list: if true;
      allow create, update, delete: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
    }
  }
}