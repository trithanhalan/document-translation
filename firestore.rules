/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a strict user-ownership model for translation tasks and public access for glossaries.
 *
 * Data Structure:
 * - /translationTasks/{taskId}: Stores translation tasks, accessible only to the owner.
 * - /glossaries/{glossaryId}: Stores glossaries, publicly accessible.
 *
 * Key Security Decisions:
 * - Translation tasks are strictly controlled by their owner. Only the owner can create, read, update, or delete tasks.
 * - Glossaries are publicly readable, but write access is open in this prototype.  In a production environment, write access to glossaries should be restricted to authorized users (e.g., admins) or the glossary owner.
 * - Listing of TranslationTasks is allowed for authenticated users.
 *
 * Denormalization for Authorization:
 * - Each TranslationTask document has an 'ownerUid' field, which is used to verify ownership. This avoids the need for complex queries or additional reads to determine authorization.
 *
 * Structural Segregation:
 * - Public and private data are stored in separate collections (/translationTasks and /glossaries, respectively) to simplify access control.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Rules for the /translationTasks/{taskId} collection.
     * @path /translationTasks/{taskId}
     * @allow (create) User with UID 'user123' can create a task with ownerUid 'user123'.
     * @allow (get) User with UID 'user123' can read a task they own.
     * @allow (update) User with UID 'user123' can update a task they own.
     * @allow (delete) User with UID 'user123' can delete a task they own.
     * @deny (create) User with UID 'user456' cannot create a task with ownerUid 'user123'.
     * @deny (get) User with UID 'user456' cannot read a task owned by 'user123'.
     * @deny (update) User with UID 'user456' cannot update a task owned by 'user123'.
     * @deny (delete) User with UID 'user456' cannot delete a task owned by 'user123'.
     * @principle Enforces document ownership for writes.
     */
    match /translationTasks/{taskId} {
      // Helper function to check if the user is signed in
      function isSignedIn() {
        return request.auth != null;
      }

      // Helper function to check if the user is the owner of the task
      function isOwner(ownerUid) {
        return request.auth.uid == ownerUid;
      }

      allow get: if isSignedIn() && isOwner(resource.data.ownerUid);
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isOwner(request.resource.data.ownerUid) && request.resource.data.id == taskId;
      allow update: if isSignedIn() && isOwner(resource.data.ownerUid) && request.resource.data.id == resource.data.id;
      allow delete: if isSignedIn() && isOwner(resource.data.ownerUid);
    }

    /**
     * @description Rules for the /glossaries/{glossaryId} collection.
     * @path /glossaries/{glossaryId}
     * @allow (get, list) Any user can read glossaries.
     * @allow (create) Any authenticated user can create a glossary.
     * @deny (update, delete) No one can update or delete a glossary. // TODO: Add owner validation once the schema is updated with an ownership field.
     * @principle Allows public read access to glossaries.
     */
    match /glossaries/{glossaryId} {
      function isSignedIn() {
        return request.auth != null;
      }

      allow get, list: if true;
      allow create: if isSignedIn();
      allow update, delete: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
    }
  }
}