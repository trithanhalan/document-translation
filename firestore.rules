/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a user-ownership model for translation tasks,
 *              allowing only the owner to read, update, or delete their own tasks.
 *              Glossaries are currently public but are designed to be easily
 *              restricted to owner-only access if needed.
 *
 * Data Structure:
 * - /translationTasks/{taskId}: Stores translation tasks, each owned by a specific user.
 * - /glossaries/{glossaryId}: Stores glossaries; currently publicly accessible.
 *
 * Key Security Decisions:
 * - Translation tasks are strictly owner-only.
 * - Glossaries are currently public but could be changed to owner-only by
 *   adding an `ownerUid` field and modifying the rules.
 * - Listing translation tasks is allowed only for the owner.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to translation tasks.
     * @path /translationTasks/{taskId}
     * @allow (get) Authenticated user can read a translation task.
     * @allow (list) Authenticated user can list translation tasks.
     * @allow (create) Authenticated user can create a translation task with matching ownerUid.
     * @allow (update) Authenticated user can update a translation task if they are the owner.
     * @allow (delete) Authenticated user can delete a translation task if they are the owner.
     * @deny (create) If the ownerUid does not match the authenticated user's ID.
     * @deny (update) If the authenticated user is not the owner.
     * @deny (delete) If the authenticated user is not the owner.
     * @principle Enforces document ownership for writes.
     */
    match /translationTasks/{taskId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && isOwner(resource.data.ownerUid);
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isSignedIn() && isExistingOwner(resource.data.ownerUid);
      allow delete: if isSignedIn() && isExistingOwner(resource.data.ownerUid);
    }

    /**
     * @description Controls access to glossaries. Currently public read, no write restrictions.
     * @path /glossaries/{glossaryId}
     * @allow (get) Any user can read a glossary.
     * @allow (list) Any user can list glossaries.
     * @allow (create) Any user can create a glossary.
     * @allow (update) Any user can update a glossary.
     * @allow (delete) Any user can delete a glossary.
     * @principle Public read, unrestricted writes.
     */
    match /glossaries/{glossaryId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(ownerUid) {
      return request.auth.uid == ownerUid;
    }

    function isExistingOwner(ownerUid) {
      return isSignedIn() && isOwner(ownerUid) && resource != null;
    }
  }
}