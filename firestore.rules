/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a user-ownership model for translation tasks,
 *              allowing only the owner to read, update, or delete their own tasks.
 *              Glossaries are currently public, but can be restricted in the future.
 *
 * Data Structure:
 * - /translationTasks/{taskId}: Contains TranslationTask documents, each owned by a specific user.
 * - /glossaries/{glossaryId}: Contains Glossary documents, currently publicly accessible.
 *
 * Key Security Decisions:
 * - Translation tasks are strictly controlled by the owner. Only the owner can create, read, update, or delete a task.
 * - Public listing of translation tasks is disallowed to prevent unauthorized access to private user data.
 * - Glossaries are currently publicly readable. This can be changed by adding an `ownerUid` field and updating the rules.
 *
 * Denormalization for Authorization:
 * - Each TranslationTask document has an `ownerUid` field, allowing us to quickly verify ownership without additional reads.
 *
 * Structural Segregation:
 * - No structural segregation is used. All translation tasks are stored in a single collection, with access controlled by the `ownerUid` field.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to translation task documents.
     * @path /translationTasks/{taskId}
     * @allow (create) User with UID 'user123' can create a translation task with ownerUid: 'user123'.
     * @allow (get) User with UID 'user123' can read a translation task they own.
     * @allow (update) User with UID 'user123' can update a translation task they own.
     * @allow (delete) User with UID 'user123' can delete a translation task they own.
     * @deny (create) User with UID 'user456' cannot create a translation task with ownerUid: 'user123'.
     * @deny (get) User with UID 'user456' cannot read a translation task owned by 'user123'.
     * @deny (update) User with UID 'user456' cannot update a translation task owned by 'user123'.
     * @deny (delete) User with UID 'user456' cannot delete a translation task owned by 'user123'.
     * @deny (list) All users are denied the ability to list all translation tasks.
     * @principle Enforces document ownership for writes. Prevents unauthorized access to translation tasks.
     */
    match /translationTasks/{taskId} {
      // Allow the owner to read their own translation task
      allow get: if isSignedIn() && isOwner(resource.data.ownerUid);

      // Prevent listing of translation tasks
      allow list: if false;

      // Allow creating a translation task if the ownerUid matches the user's ID
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;

      // Allow updates if the user is the owner and the document exists. Enforce immutability of ownerUid.
      allow update: if isSignedIn() && isExistingOwner(resource.data.ownerUid) && (request.resource.data.ownerUid == resource.data.ownerUid);

      // Allow deletion if the user is the owner and the document exists
      allow delete: if isSignedIn() && isExistingOwner(resource.data.ownerUid);
    }

    /**
     * @description Controls access to glossary documents. Currently allows public read access.
     * @path /glossaries/{glossaryId}
     * @allow (get, list) All users can read glossary documents.
     * @deny (create, update, delete) All create, update and delete operations are denied.
     * @principle Allows public read access to glossaries. Write operations are disabled.
     */
    match /glossaries/{glossaryId} {
      // Allow anyone to read glossaries
      allow get, list: if true;

      // Disallow creating, updating, or deleting glossaries for now
      allow create, update, delete: if false;
    }
  }

  // Helper function to check if the user is signed in
  function isSignedIn() {
    return request.auth != null;
  }

  // Helper function to check if the user is the owner of the document
  function isOwner(ownerUid) {
    return request.auth.uid == ownerUid;
  }

  // Helper function to check if the user is the owner of the document and the document exists
  function isExistingOwner(ownerUid) {
    return isOwner(ownerUid) && resource != null;
  }
}