/**
 * @file Overview
 * This ruleset enforces a user-ownership model for translation tasks,
 * where each task is associated with a specific user.
 * Glossaries are currently public but the structure supports restricted access.
 *
 * @dataStructure
 * - /translationTasks/{taskId}: Stores translation task documents, accessible only to the owner.
 * - /glossaries/{glossaryId}: Stores glossary documents, publicly accessible.
 *
 * @keySecurityDecisions
 * - Users can only create, update, or delete their own translation tasks.
 * - Listing translation tasks is allowed only for the owner.
 * - Glossaries are publicly readable.
 * - The `ownerUid` field in `translationTasks` is immutable after creation.
 *
 * @denormalizationForAuthorization
 * - The `translationTasks` documents include an `ownerUid` field, which allows the security rules to quickly verify ownership without additional reads.
 *
 * @structuralSegregation
 * - Public glossaries are stored in a top-level collection.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Manages access to individual translation tasks.
     * @path /translationTasks/{taskId}
     * @allow (create) User with UID 'user123' can create a task with ownerUid: 'user123'.
     * @allow (update) User with UID 'user123' can update a task they own.
     * @allow (delete) User with UID 'user123' can delete a task they own.
     * @deny (create) User with UID 'user456' cannot create a task with ownerUid: 'user123'.
     * @deny (update) User with UID 'user456' cannot update a task owned by 'user123'.
     * @deny (delete) User with UID 'user456' cannot delete a task owned by 'user123'.
     * @principle Enforces document ownership for writes.
     */
    match /translationTasks/{taskId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(ownerUid) {
        return isSignedIn() && request.auth.uid == ownerUid;
      }

      function isExistingOwner(ownerUid) {
        return isOwner(ownerUid) && resource != null;
      }

      allow get: if true;
      allow list: if isSignedIn() && isOwner(request.auth.uid);
      allow create: if isSignedIn() && isOwner(request.resource.data.ownerUid);
      allow update: if isExistingOwner(resource.data.ownerUid) && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if isExistingOwner(resource.data.ownerUid);
    }

    /**
     * @description Manages access to glossaries. Currently allows public read access.
     * @path /glossaries/{glossaryId}
     * @allow (get) Any user can read a glossary.
     * @allow (list) Any user can list glossaries.
     * @deny (create) No one can create glossaries. // TODO: Add owner validation once the schema is updated with an ownership field.
     * @deny (update) No one can update glossaries. // TODO: Add owner validation once the schema is updated with an ownership field.
     * @deny (delete) No one can delete glossaries. // TODO: Add owner validation once the schema is updated with an ownership field.
     */
    match /glossaries/{glossaryId} {
      allow get, list: if true;
      allow create, update, delete: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
    }
  }
}