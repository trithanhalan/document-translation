/**
 * @file Firestore Security Rules
 * @core_philosophy This ruleset enforces a strict user-ownership model for translation tasks stored under `/users/{userId}/translationTasks/{taskId}`.
 *   Glossaries stored at `/glossaries/{glossaryId}` are publicly accessible.
 * @data_structure
 *   - `/users/{userId}/translationTasks/{taskId}`: Stores translation tasks owned by a specific user.
 *   - `/glossaries/{glossaryId}`: Stores publicly accessible glossaries.
 * @key_security_decisions
 *   - Users can only access their own translation tasks.
 *   - Public read access to glossaries is granted.
 *   - Data validation is relaxed in this prototyping phase, focusing on authorization.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to translation tasks for a specific user.
     * @path /users/{userId}/translationTasks/{taskId}
     * @allow (create) - User 'user123' can create a translation task with ownerUid: 'user123'.
     * @allow (get) - User 'user123' can get their translation task 'task456'.
     * @allow (update) - User 'user123' can update their translation task 'task456'.
     * @allow (delete) - User 'user123' can delete their translation task 'task456'.
     * @deny (create) - User 'user456' cannot create a translation task under user 'user123'.
     * @deny (get) - User 'user456' cannot get user 'user123's translation task 'task456'.
     * @deny (update) - User 'user456' cannot update user 'user123's translation task 'task456'.
     * @deny (delete) - User 'user456' cannot delete user 'user123's translation task 'task456'.
     * @principle Enforces document ownership, restricting access to the owning user only.
     */
    match /users/{userId}/translationTasks/{taskId} {
      // Read rules
      allow get: if isSignedIn() && isOwner(userId);
      allow list: if isSignedIn() && isOwner(userId);

      // Write rules
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.ownerUid == userId;
      allow update: if isSignedIn() && isExistingOwner(userId) && resource.data.ownerUid == userId;
      allow delete: if isSignedIn() && isExistingOwner(userId);
    }

    /**
     * @description Controls access to glossaries. Public read, no write access control.
     * @path /glossaries/{glossaryId}
     * @allow (get) - Any user can get a glossary.
     * @allow (list) - Any user can list glossaries.
     * @deny (create) - No user can create a glossary.
     * @deny (update) - No user can update a glossary.
     * @deny (delete) - No user can delete a glossary.
     * @principle Allows public read access but restricts all write operations.
     */
    match /glossaries/{glossaryId} {
      // Read rules: Public read access
      allow get, list: if true;

      // Write rules: No write access
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // --- Helper functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
    }
  }
}