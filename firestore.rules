/**
 * @fileoverview Firestore Security Rules for the translation app.
 *
 * Core Philosophy:
 * This ruleset enforces a user-ownership model for translation tasks and public read access for glossaries.
 *
 * Data Structure:
 * - /translationTasks/{taskId}: Documents representing translation tasks, owned by a specific user.
 * - /glossaries/{glossaryId}: Documents representing glossaries, publicly readable.
 *
 * Key Security Decisions:
 * - Listing of translation tasks is allowed only for the task owner.
 * - Glossaries are publicly readable, but write rules are open for prototyping.  Consider restricting to authenticated users or admins in production.
 * - The `ownerUid` field in `translationTasks` is used to enforce ownership.
 *
 * Denormalization for Authorization:
 * - The `translationTasks` documents must contain the `ownerUid` to allow for simple ownership checks.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to translation task documents.
     * @path /translationTasks/{taskId}
     * @allow (get) Signed-in user can get any task.
     * @allow (list) Signed-in user can list their own tasks.
     * @allow (create) Signed-in user can create a task with their UID as the ownerUid.
     * @allow (update) Signed-in user can update their own task.
     * @allow (delete) Signed-in user can delete their own task.
     * @deny (get) User tries to access a non-existent task.
     * @deny (list) User tries to list tasks that don't belong to them.
     * @deny (create) User attempts to create a task with an ownerUid that doesn't match their UID.
     * @deny (update) User tries to update a task they don't own.
     * @deny (delete) User tries to delete a task they don't own, or a non-existent task.
     * @principle Enforces document ownership for writes and allows owner-only listing.
     */
    match /translationTasks/{taskId} {
      // Helpers
      function isSignedIn() {
        return request.auth != null;
      }
      function isOwner(ownerUid) {
        return isSignedIn() && request.auth.uid == ownerUid;
      }
      function isExistingOwner(ownerUid) {
        return isOwner(ownerUid) && resource != null;
      }

      // Read rules
      allow get: if true;
      allow list: if isSignedIn() && isOwner(request.auth.uid);

      // Write rules
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isExistingOwner(resource.data.ownerUid);
      allow delete: if isExistingOwner(resource.data.ownerUid);
    }

    /**
     * @description Controls access to glossary documents.
     * @path /glossaries/{glossaryId}
     * @allow (get) Any user can read glossary.
     * @allow (list) Any user can list glossary.
     * @allow (create) Any user can create glossary.
     * @allow (update) Any user can update glossary.
     * @allow (delete) Any user can delete glossary.
     * @principle Allows public read access to glossaries.  Write access is open for prototyping.
     */
    match /glossaries/{glossaryId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }
  }
}