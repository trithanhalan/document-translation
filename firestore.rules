/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a strict user-ownership model for translation tasks and allows public read access for glossaries.
 *
 * Data Structure:
 * - All translation tasks are nested under /users/{userId}/translationTasks/{taskId}.
 * - Glossaries are stored in a top-level /glossaries/{glossaryId} collection.
 *
 * Key Security Decisions:
 * - Users can only access their own translation tasks.
 * - Glossaries are publicly readable. Write access to glossaries is not explicitly defined and should be secured separately if needed.
 * - Listing of translation tasks is restricted to the owner of the tasks.
 *
 * Denormalization for Authorization:
 * - Translation tasks include an `ownerUid` field that MUST match the `userId` in the path.
 *   This ensures that the user ID in the path matches the user ID stored in the document.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows a user to read, create, update, and delete their own translation tasks.
     * @path /users/{userId}/translationTasks/{taskId}
     * @allow (create) User with UID 'user123' creates a new translation task under /users/user123/translationTasks/task456. The request data contains 'ownerUid': 'user123'.
     * @allow (get) User with UID 'user123' reads a translation task from /users/user123/translationTasks/task456.
     * @allow (update) User with UID 'user123' updates a translation task at /users/user123/translationTasks/task456.
     * @allow (delete) User with UID 'user123' deletes a translation task from /users/user123/translationTasks/task456.
     * @deny (create) User with UID 'user123' attempts to create a task under /users/user456/translationTasks/task456.
     * @deny (get) User with UID 'user123' attempts to read a task from /users/user456/translationTasks/task456.
     * @deny (update) User with UID 'user123' attempts to update a task at /users/user456/translationTasks/task456.
     * @deny (delete) User with UID 'user123' attempts to delete a task from /users/user456/translationTasks/task456.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId}/translationTasks/{taskId} {
      // Read rules
      allow get: if isSignedIn() && isOwner(userId);
      allow list: if isSignedIn() && isOwner(userId);

      // Write rules
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.ownerUid == userId;
      allow update: if isSignedIn() && isExistingOwner(userId) && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if isSignedIn() && isExistingOwner(userId);
    }

    /**
     * @description Allows anyone to read glossaries. Write access is not explicitly defined and should be secured separately if needed.
     * @path /glossaries/{glossaryId}
     * @allow (get) Any user can read a glossary.
     * @allow (list) Any user can list glossaries.
     * @deny (create) No one can create glossaries, should be done via cloud function.
     * @deny (update) No one can update glossaries, should be done via cloud function.
     * @deny (delete) No one can delete glossaries, should be done via cloud function.
     * @principle Allows public read access to glossaries.
     */
    match /glossaries/{glossaryId} {
        allow get, list: if true;
        allow create, update, delete: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
    }
  }
}