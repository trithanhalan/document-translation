/**
 * @fileoverview Firestore Security Rules for the translation app.
 *
 * Core Philosophy:
 * This ruleset enforces a user-ownership model for translation tasks, ensuring that only the owner can read, update, or delete their tasks.
 * Glossaries are currently public but have a placeholder for owner-based restrictions in the future.
 *
 * Data Structure:
 * - /translationTasks/{taskId}: Stores individual translation tasks, with 'ownerUid' indicating the task owner.
 * - /glossaries/{glossaryId}: Stores glossaries of terms.
 *
 * Key Security Decisions:
 * - User listing is disallowed for all collections.
 * - Ownership is strictly enforced for all write operations on translation tasks.
 * - Denormalization: The 'ownerUid' field within the `translationTasks` document is used to efficiently check ownership, avoiding costly `get()` calls.
 *
 * Potential Future Improvements:
 * - Add ownerUid to the Glossary entity and implement owner-based restrictions on glossaries.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Secures translation tasks, ensuring only the owner can manage them.
     * @path /translationTasks/{taskId}
     * @allow (create) User A creates a new task with ownerUid: A.
     * @allow (update) User A updates a task they own (ownerUid: A).
     * @allow (delete) User A deletes a task they own (ownerUid: A).
     * @deny (create) User B attempts to create a task with ownerUid: A.
     * @deny (update) User B attempts to update User A's task.
     * @deny (delete) User B attempts to delete User A's task.
     * @principle Enforces document ownership for writes; requires a valid auth token for all operations.
     */
    match /translationTasks/{taskId} {
      // Anyone can get a translationTask document
      allow get: if true;

      // Only the owner can list translationTask documents
      allow list: if isSignedIn() && isOwner(resource.data.ownerUid);

      // Only the owner can create a translationTask, and the ownerUid must match the authenticated user.
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid && request.resource.data.id == taskId;

      // Only the owner can update an existing translationTask. ownerUid cannot be changed.
      allow update: if isSignedIn() && isExistingOwner(resource.data.ownerUid) && request.resource.data.id == resource.data.id;

      // Only the owner can delete an existing translationTask.
      allow delete: if isSignedIn() && isExistingOwner(resource.data.ownerUid);
    }

    /**
     * @description Secures glossaries. Currently public read, but could be restricted by adding an ownerUid.
     * @path /glossaries/{glossaryId}
     * @allow (get, list) Anyone can read glossaries.
     * @deny (create, update, delete) No one can create, update, or delete glossaries (currently).
     * @principle Placeholder for owner-based restrictions on glossaries.
     */
    match /glossaries/{glossaryId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    // --- Helper functions ---
    // Checks if the user is signed in.
    function isSignedIn() {
      return request.auth != null;
    }

    // Checks if the user is the owner of the resource based on the provided userId.
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

   // Checks if the user is the owner of an *existing* resource.
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }
  }
}