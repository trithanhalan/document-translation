/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a user-ownership model for translation tasks,
 *              allowing only the task owner to read, update, or delete their own tasks.
 *              Glossaries are currently public but can be restricted by adding an `ownerUid`.
 *
 * Data Structure:
 * - /translationTasks/{taskId}: Stores individual translation tasks, accessible only by the owner.
 *   Each task document MUST contain an 'ownerUid' field matching the authenticated user's UID.
 * - /glossaries/{glossaryId}: Stores glossaries of terms, currently publicly accessible.
 *
 * Key Security Decisions:
 * - User listing is disallowed to prevent enumeration.
 * - Glossary access is currently public, but the rules include a placeholder for future owner-based restrictions.
 * - Write operations on `/translationTasks/{taskId}` require that the `ownerUid` field matches the authenticated user's UID,
 *   ensuring that only the owner can create, update, or delete a task.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to individual translation tasks.
     * @path /translationTasks/{taskId}
     * @allow (get, update, delete) User with uid 'user_abc' can read, update, and delete a task where task.ownerUid == 'user_abc'.
     * @allow (create) User with uid 'user_abc' can create a task where request.resource.data.ownerUid == 'user_abc'.
     * @deny (get, update, delete) User with uid 'user_def' cannot read, update, or delete a task where task.ownerUid == 'user_abc'.
     * @deny (create) User with uid 'user_def' cannot create a task where request.resource.data.ownerUid == 'user_abc'.
     * @principle Enforces document ownership for writes, restricts access to owner for reads.
     */
    match /translationTasks/{taskId} {
      // Helper function to check if the current user is the owner of the task.
      function isOwner(ownerUid) {
        return request.auth != null && request.auth.uid == ownerUid;
      }

      // Helper function to check if the current user is the existing owner of the task and that the document exists.
      function isExistingOwner(ownerUid) {
        return isOwner(ownerUid) && resource != null;
      }

      // Read permissions: only the owner can read a task.
      allow get: if isOwner(resource.data.ownerUid);
      allow list: if isOwner(resource.data.ownerUid);

      // Write permissions: only the owner can create, update, or delete a task.
      allow create: if isOwner(request.resource.data.ownerUid);
      allow update: if isExistingOwner(resource.data.ownerUid) && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if isExistingOwner(resource.data.ownerUid);
    }

    /**
     * @description Controls access to glossaries. Currently, glossaries are publicly accessible.
     *              Future versions may restrict access based on an owner UID.
     * @path /glossaries/{glossaryId}
     * @allow (get, list) Any user (or no user) can read/list glossaries.
     * @allow (create, update, delete) No one can create, update or delete glossaries unless they are signed in.
     * @principle Currently public read, future: owner-only writes.
     */
    match /glossaries/{glossaryId} {
      allow get: if true;
      allow list: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null;
    }
  }
}